<section id="commed-nosotros" class="commed-about commed-section page-width" aria-labelledby="CommedAbout-{{ section.id }}">
  <div class="commed-about__panel">
    <div><p class="commed-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="CommedAbout-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <div class="commed-about__copy"><div class="rte">{{ section.settings.description }}</div>
      {% assign about_link = section.settings.link | default: pages.contact.url %}
      <div class="commed-about__actions">
        {% render 'commed-whatsapp-link', variant: 'section', label: section.settings.whatsapp_label, show_number: true %}
        {% if about_link != blank and section.settings.link_label != blank %}<a class="button button--secondary" href="{{ about_link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
      </div>
      {% render 'commed-social-links', variant: 'section', heading: section.settings.social_heading %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"COMMED · Nosotros",
  "limit":1,
  "enabled_on":{"templates":["index"]},
  "settings":[
    {"type":"text","id":"eyebrow","label":"Etiqueta","default":"CERCA DE QUIENES CUIDAN"},
    {"type":"text","id":"heading","label":"Título","default":"Servicio claro, humano y especializado."},
    {"type":"richtext","id":"description","label":"Descripción","default":"<p>En COMMED nos dedicamos a la distribución de material de curación e insumos médicos. Nuestro propósito es facilitar el acceso a lo esencial para clínicas, consultorios y profesionales de la salud.</p>"},
    {"type":"text","id":"whatsapp_label","label":"Acción de WhatsApp","default":"Escríbenos por WhatsApp"},
    {"type":"text","id":"social_heading","label":"Título de redes sociales","default":"También puedes encontrarnos en"},
    {"type":"text","id":"link_label","label":"Acción","default":"Ponte en contacto"},
    {"type":"url","id":"link","label":"Enlace","info":"Sin selección se usa la página existente con identificador contact. Si no existe, se oculta la acción."}
  ],
  "presets":[{"name":"COMMED · Nosotros"}]
}
{% endschema %}
