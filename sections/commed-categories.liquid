<section id="commed-categorias" class="commed-categories commed-section page-width" aria-labelledby="CommedCategories-{{ section.id }}">
  <div class="commed-section-heading">
    <div><p class="commed-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="CommedCategories-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <a class="commed-text-link" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="commed-category-grid">
    {% for block in section.blocks %}
      {% liquid
        assign category_image = block.settings.image | default: block.settings.collection.featured_image
        assign category_url = block.settings.link | default: block.settings.collection.url
        if category_url == blank
          assign category_query = block.settings.title | url_encode
          assign category_url = routes.search_url | append: '?type=product&q=' | append: category_query
        endif
        assign fallback_image = 'commed-category-' | append: block.settings.fallback | append: '.webp'
      %}
      <a class="commed-category" href="{{ category_url }}" {{ block.shopify_attributes }}>
        <div class="commed-category__image">
          {% if category_image != blank %}
            {{ category_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw', loading: 'lazy', alt: '' }}
          {% else %}
            <img src="{{ fallback_image | asset_url }}" alt="" width="800" height="600" loading="lazy">
          {% endif %}
        </div>
        <div class="commed-category__body"><h3>{{ block.settings.title | escape }}</h3><span class="commed-category__arrow" aria-hidden="true">↗</span></div>
        <p>{{ block.settings.description | escape }}</p>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"COMMED · Categorías",
  "limit":1,
  "enabled_on":{"templates":["index"]},
  "max_blocks":8,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Etiqueta","default":"ENCUENTRA LO QUE NECESITAS"},
    {"type":"text","id":"heading","label":"Título","default":"Todo para tu día a día."},
    {"type":"text","id":"link_label","label":"Enlace al catálogo","default":"Ver todo el catálogo"}
  ],
  "blocks":[{"type":"category","name":"Categoría","settings":[
    {"type":"text","id":"title","label":"Nombre","default":"Material de curación"},
    {"type":"text","id":"description","label":"Descripción","default":"Esenciales para el cuidado diario."},
    {"type":"collection","id":"collection","label":"Colección","info":"Sin colección ni enlace se realiza una búsqueda por el nombre de la categoría."},
    {"type":"url","id":"link","label":"Enlace alternativo"},
    {"type":"image_picker","id":"image","label":"Imagen"},
    {"type":"select","id":"fallback","label":"Imagen COMMED de respaldo","default":"curacion","options":[{"value":"curacion","label":"Curación"},{"value":"quirurgico","label":"Quirúrgico"},{"value":"diagnostico","label":"Diagnóstico"},{"value":"consumibles","label":"Consumibles"}]}
  ]}],
  "presets":[{"name":"COMMED · Categorías","blocks":[{"type":"category"}]}]
}
{% endschema %}
