<section class="commed-hero page-width" aria-labelledby="CommedHero-{{ section.id }}">
  <div class="commed-hero__panel">
    <div class="commed-hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '600, 1000, 1400, 2000', sizes: '(min-width: 1280px) 1280px, 100vw', loading: 'eager', fetchpriority: 'high', class: 'commed-hero__image' }}
      {% else %}
        <img class="commed-hero__image" src="{{ 'commed-hero.webp' | asset_url }}" alt="Selección de material de curación e insumos médicos" width="1400" height="900" fetchpriority="high">
      {% endif %}
    </div>
    <div class="commed-hero__content">
      <p class="commed-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="CommedHero-{{ section.id }}">{{ section.settings.heading | escape }} <span>{{ section.settings.accent | escape }}</span></h1>
      <div class="commed-hero__description rte">{{ section.settings.description }}</div>
      <div class="commed-actions">
        {% if section.settings.button_label != blank %}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">&rarr;</span></a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="commed-text-link" href="{{ section.settings.secondary_link | default: '#commed-categorias' }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">↗</span></a>
        {% endif %}
      </div>
      {% if section.settings.note != blank %}<p class="commed-hero__note">{{ section.settings.note | escape }}</p>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "COMMED · Portada",
  "limit": 1,
  "enabled_on": {"templates":["index"]},
  "settings": [
    {"type":"image_picker","id":"image","label":"Imagen de portada","info":"Sin selección se usa la imagen COMMED incluida. Mantener espacio libre a la izquierda para el texto."},
    {"type":"text","id":"eyebrow","label":"Etiqueta","default":"MATERIAL DE CURACIÓN E INSUMOS MÉDICOS"},
    {"type":"text","id":"heading","label":"Título","default":"Insumos que cuidan"},
    {"type":"text","id":"accent","label":"Frase destacada","default":"cada detalle."},
    {"type":"richtext","id":"description","label":"Descripción","default":"<p>Lo esencial para tu práctica, en un solo lugar. Material de curación, consumibles y soluciones para profesionales de la salud.</p>"},
    {"type":"text","id":"button_label","label":"Acción principal","default":"Explorar catálogo"},
    {"type":"url","id":"button_link","label":"Enlace principal","info":"Sin selección abre el catálogo de Shopify."},
    {"type":"text","id":"secondary_label","label":"Acción secundaria","default":"Ver categorías"},
    {"type":"url","id":"secondary_link","label":"Enlace secundario","info":"Sin selección lleva a las categorías de esta portada."},
    {"type":"text","id":"note","label":"Nota inferior","default":"Para clínicas, consultorios y profesionales de la salud."}
  ],
  "presets": [{"name":"COMMED · Portada"}]
}
{% endschema %}
