{% doc %}
  Enlaces iniciales sin depender de colecciones o páginas aún no creadas.
  @param {string} [link_class] - Clases de los enlaces del menú.
{% enddoc %}
<li><a class="{{ link_class }}" href="{{ routes.root_url }}">Inicio</a></li>
