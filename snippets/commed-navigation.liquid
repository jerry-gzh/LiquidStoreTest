<li><a class="{{ link_class }}" data-commed-anchor href="{{ routes.root_url }}#commed-categorias">Categorías</a></li>
<li><a class="{{ link_class }}" data-commed-anchor href="{{ routes.root_url }}#commed-proposito">Misión y visión</a></li>
<li><a class="{{ link_class }}" data-commed-anchor href="{{ routes.root_url }}#commed-nosotros">Nosotros</a></li>
{% assign contact_url = pages.contact.url | default: '/pages/contact' %}
<li><a class="{{ link_class }}" href="{{ contact_url }}">Contacto</a></li>
