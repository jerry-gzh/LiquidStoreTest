{% liquid
  assign whatsapp_number = settings.commed_whatsapp_number | default: '5214431600867'
  assign whatsapp_number = whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign display_number = settings.commed_whatsapp_display | default: '+52 1 443 160 0867'
  assign link_label = label | default: 'Escríbenos por WhatsApp'
  assign link_class = 'commed-whatsapp-link'

  if variant != blank
    assign link_class = link_class | append: ' commed-whatsapp-link--' | append: variant
  endif
%}

{% if settings.commed_whatsapp_enabled and whatsapp_number != blank %}
  <a
    class="{{ link_class }}"
    href="https://wa.me/{{ whatsapp_number }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp al {{ display_number | escape }}; se abre en una ventana nueva"
  >
    <span class="commed-whatsapp-link__icon" aria-hidden="true">
      {% render 'commed-social-icon', name: 'whatsapp' %}
    </span>
    {% unless icon_only %}
      <span class="commed-whatsapp-link__content">
        <span>{{ link_label | escape }}</span>
        {% if show_number %}<small>{{ display_number | escape }}</small>{% endif %}
      </span>
    {% endunless %}
    {% if variant == 'floating' %}<span class="commed-whatsapp-link__tooltip" aria-hidden="true">WhatsApp</span>{% endif %}
  </a>
{% endif %}
